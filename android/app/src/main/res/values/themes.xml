<resources>
    <!-- Compose paints everything; this exists so the window has the right background
         before the first frame, rather than a white flash. `DayNight` is an AppCompat
         thing and this app is pure Compose on ComponentActivity, so the two cases are
         split across values/ and values-night/ instead. -->
    <style name="Theme.AgentRouter" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
