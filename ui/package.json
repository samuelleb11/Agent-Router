{
  "name": "agent-router-console",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-chunks.mjs && node scripts/notices.mjs --check",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "chunks:check": "node scripts/check-chunks.mjs",
    "palette:check": "node scripts/check-palette.mjs",
    "notices": "node scripts/notices.mjs",
    "notices:check": "node scripts/notices.mjs --check",
    "harness": "vite --config vite.harness.config.ts",
    "shots": "node scripts/shoot.mjs"
  },
  "dependencies": {
    "@carbon/charts": "^1.27.20",
    "@carbon/charts-react": "^1.27.20",
    "@carbon/icons-react": "^11.68.0",
    "@carbon/layout": "^11.59.0",
    "@carbon/react": "^1.116.0",
    "@tanstack/react-query": "^5.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@carbon/themes": "^11.81.0",
    "@eslint/js": "^9.36.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^6.1.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^17.12.0",
    "jsdom": "^27.0.0",
    "sass-embedded": "^1.93.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
